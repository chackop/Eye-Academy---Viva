# LLM for the spoken follow-up and revision point (server-side only, never sent to the browser)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Firebase web config. Leave USE_EMULATOR=true to run fully local against the emulators.
VITE_USE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-eye-viva.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-eye-viva
VITE_FIREBASE_APP_ID=demo-app
