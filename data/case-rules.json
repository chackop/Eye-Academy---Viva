  },
  {
   "key": "Check sulfonamide allergy before giving acetazolamide",
   "hit": "sulfa|sulfonamide|allerg",
   "onlyIf": "acetazolamide|diamox|carbonic anhydrase"
  },
  {
   "key": "Stop the chlorphenamine (anticholinergic antihistamine trigger)",
   "hit": "chlorphenamine|antihistamine|anticholinergic|stop (the )?(drug|medic|tablet)"
  },
  {
   "key": "Give analgesia and an antiemetic",
   "hit": "analgesi|pain ?relief|paracetamol|morphine|antiemetic|anti.?sickness|ondansetron|cyclizine|metoclopramide"
  },
  {
